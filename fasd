# fasd requires zsh 5.5 or newer (works both when sourced and when executed)
autoload -Uz is-at-least
is-at-least 5.5 || {
  print -u2 "fasd: zsh >= 5.5 required"
  return 1 2>/dev/null || exit 1
}

_FASD_VERSION='1.0.1 (zsh-optimized)'

# Returns 0 when writing to $_FASD_DATA is allowed.
_fasd_writable() {
  [[ -f "$_FASD_DATA" && ! -O "$_FASD_DATA" ]] || [[ -n "$_FASD_RO" ]] && return 1
  return 0
}

# lock $_FASD_DATA for writing, sets the CALLER's local $lockfd (dynamic scope)
_fasd_lock() {
  # retry for up to 1 second, then give up: the hook must not block the prompt
  { : >> "$_FASD_DATA.lock" } 2>> "${_FASD_SINK:-/dev/null}" || return
  local n
  for (( n = 0; n < 100; n++ )); do
    zsystem flock -t 0 -f lockfd "$_FASD_DATA.lock" 2>/dev/null && return
    zselect -t 1 # 10 ms
  done
  return 1
}

# shared body of --add/--delete: lock, rewrite $_FASD_DATA through awk, mv/rm.
# usage: _fasd_db_rewrite <awk-program> [awk -v args...]
# the caller exports the path list through _fasd_list, passed via ENVIRON.
_fasd_db_rewrite() {
  local awk_program="$1"
  shift
  local lockfd tempfile
  _fasd_lock || return
  {
    [[ -e "$_FASD_DATA" ]] || : >| "$_FASD_DATA"
    tempfile="$(mktemp "${_FASD_DATA}.XXXXXX")" || return

    $_FASD_AWK "$@" -F"|" "$awk_program" "$_FASD_DATA" \
      2>> "${_FASD_SINK:-/dev/null}" >| "$tempfile"

    if [[ $? -eq 0 ]]; then
      command mv -f "$tempfile" "$_FASD_DATA"
    else
      command rm -f "$tempfile"
    fi
  } always {
    zsystem flock -u $lockfd
  }
}

# add entries
_fasd_add() {
  _fasd_writable || return

  local -a valid_paths
  local p abs
  for p in "$@"; do
    # strip quotes if any
    if [[ -e "${(Q)p}" ]]; then
      abs="${${(Q)p}:a}"
    elif [[ -e "$p" ]]; then
      abs="${p:a}"
    else
      continue
    fi
    # the data file format cannot represent '|' or newline in a path
    [[ "$abs" == *[$'|\n']* ]] && continue
    valid_paths+="$abs"
  done

  if [[ "$_FASD_TRACK_PWD" == "1" && "$PWD" != "$HOME" ]]; then
    [[ "${PWD:a}" == *[$'|\n']* ]] || valid_paths+="${PWD:a}"
  fi

  (( ${#valid_paths} == 0 )) && return

  local now="${_FASD_NOW:-$EPOCHSECONDS}"

  # paths go through ENVIRON: no escape processing, newline separated
  _fasd_list="${(pj:\n:)valid_paths}" _fasd_db_rewrite '
    BEGIN {
      split(ENVIRON["_fasd_list"], files, "\n")
      for(i in files) {
        path = files[i]
        if(path == "") continue
        paths[path] = path # array for checking
        rank[path] = 1
        time[path] = now
      }
    }
    $2 >= 1 {
      if($1 in paths) {
        rank[$1] = $2 + 1 / $2
        time[$1] = now
      } else {
        rank[$1] = $2
        time[$1] = $3
      }
      count += $2
    }
    END {
      if(count > max)
        for(i in rank) print i "|" 0.9*rank[i] "|" time[i] # aging
      else
        for(i in rank) print i "|" rank[i] "|" time[i]
    }' -v now="$now" -v max="$_FASD_MAX"
}

# delete entries
_fasd_delete() {
  _fasd_writable || return
  [[ -f "$_FASD_DATA" ]] && (( $# > 0 )) || return

  local -a del_paths
  local p
  for p in "$@"; do
    del_paths+="${p:a}"
  done

  _fasd_list="${(pj:\n:)del_paths}" _fasd_db_rewrite '
    BEGIN {
      split(ENVIRON["_fasd_list"], files, "\n")
      for(i in files) if(files[i] != "") to_del[files[i]] = 1
    }
    !($1 in to_del)
  '
}

# process commands, invoked from the preexec hook
_fasd_proc() {
  # stop if we don't own $_FASD_DATA or $_FASD_RO is set
  _fasd_writable || return

  # check blacklist
  local -A bl shf ig
  local x
  for x in ${(s: :)${_FASD_BLACKLIST:---help}}; do bl[$x]=1; done
  for x in ${(s: :)${_FASD_SHIFT:=sudo busybox}}; do shf[$x]=1; done
  for x in ${(s: :)${_FASD_IGNORE:=fasd ls echo}}; do ig[$x]=1; done

  for x in "$@"; do
    (( $+bl[$x] )) && return
  done

  # shifts
  while (( $# > 0 && $+shf[$1] )); do
    shift
  done

  # ignores
  (( $# > 0 && $+ig[$1] )) && return

  shift
  _fasd_add "$@" # add all arguments except command
}

# if "$_fasd_cur" or "$2" is a query, then output shell code to be eval'd
_fasd_word_complete_trigger() {
  local _fasd_cur="${2:-$1}"
  [ -z "$_fasd_cur" ] && return
  case $_fasd_cur in
    ,*)     printf '%s\n' "$1 e $_fasd_cur" ;;
    f,*)    printf '%s\n' "$1 f ${_fasd_cur#?}" ;;
    d,*)    printf '%s\n' "$1 d ${_fasd_cur#?}" ;;
    *,,)    printf '%s\n' "$1 e $_fasd_cur" ;;
    *,,f)   printf '%s\n' "$1 f ${_fasd_cur%?}" ;;
    *,,d)   printf '%s\n' "$1 d ${_fasd_cur%?}" ;;
  esac
}

_fasd_backend() {
  case $1 in
    native) [[ -f "$_FASD_DATA" ]] && cat "$_FASD_DATA" ;;
    viminfo)
      < "$_FASD_VIMINFO" sed -n '/^>/{s@~@'"$HOME"'@
        s/^..//
        p
        }' | $_FASD_AWK -v t="${_FASD_NOW:-$EPOCHSECONDS}" '{
          t -= 60
          print $0 "|1|" t
        }'
      ;;
    recently-used)
      local nl=$'\\\n' # backslash newline for sed
      tr -d '\n' < "$_FASD_RECENTLY_USED_XBEL" | \
        sed 's@file://@'"$nl"'@g;s@count="@'"$nl"'@g' | sed '1d;s/".*$//' | \
        tr '\n' '|' | sed 's@|/@'"$nl"'/@g' | $_FASD_AWK -F'|' '{
          sum = 0
          for( i=2; i<=NF; i++ ) sum += $i
          print $1 "|" sum
        }'
      ;;
    current)
      local entry
      for entry in *(N); do
        printf '%s|1\n' "$PWD/$entry"
      done
      ;;
    spotlight)
      mdfind '(kMDItemFSContentChangeDate >= $time.today) ||
        kMDItemLastUsedDate >= $time.this_month' \
        | sed '/Library\//d
          /\.app$/d
          s/$/|2/'
      ;;
    *) eval "$1" ;;
  esac
}

# prints the raw path|rank|time rows from the configured backends
_fasd_query_load() {
  local _fasd_data
  if [[ "$_FASD_BACKENDS" == "native" ]]; then
    [[ -f "$_FASD_DATA" ]] || return # no db yet
    _fasd_data="$(< "$_FASD_DATA")"
  else
    local each
    for each in ${(s: :)${_FASD_BACKENDS}}; do
      _fasd_data+="$(_fasd_backend "$each")"$'\n'
    done
    [[ -n "$_fasd_data" || ! -f "$_FASD_DATA" ]] || _fasd_data="$(< "$_FASD_DATA")"
  fi
  [[ -n "$_fasd_data" ]] && printf '%s' "$_fasd_data"
}

# builds the patterns of the matching passes, tried in order, into the
# CALLER's local -a pats (dynamic scope)
_fasd_query_patterns() {
  local fnd="$1"
  if [[ -n "$fnd" ]]; then
    local -a words qwords fuzzy_words
    local w fw i tail='[^/]#'
    words=(${(s: :)fnd})
    # the last word matches the last path segment, or the end with '$'
    if [[ "$words[-1]" == *\$ ]]; then
      words[-1]="${words[-1]%\$}"
      tail=
    fi
    for w in $words; do
      qwords+="${(b)w}"
    done
    # 1. exact case, 2. case-insensitive
    pats=("*${(j:*:)qwords}$tail" "(#i)*${(j:*:)qwords}$tail")
    # 3. fuzzy: up to $_FASD_FUZZY chars may be skipped within a segment
    if (( ${_FASD_FUZZY:-0} > 0 )); then
      for w in $words; do
        fw="${(b)w[1]}"
        for (( i=2; i<=${#w}; i++ )); do
          fw+="[^/](#c0,$_FASD_FUZZY)${(b)w[i]}"
        done
        fuzzy_words+="$fw"
      done
      pats+="(#i)*${(j:*:)fuzzy_words}$tail"
    fi
  else
    pats=('*')
  fi
}

# reads matched path|rank|time lines on stdin, takes $mode, prints "score path"
_fasd_query_score() {
  local mode="$1"

  # calculate frecency scores
  local prior
  case $mode in
    rank) prior='times[i]' ;;
    recent) prior='sqrt(100000/(1+t-la[i]))' ;;
    *) prior='times[i] * frecent(la[i])' ;;
  esac

  local now="${_FASD_NOW:-$EPOCHSECONDS}"
  $_FASD_AWK -v t="$now" -F"|" "
    function frecent(time) {
      dx = t - time
      if (dx < 3600) return 6
      if (dx < 86400) return 4
      if (dx < 604800) return 2
      return 1
    }
    {
      if (!paths[\$1]) {
        times[\$1] = \$2
        la[\$1] = \$3
        paths[\$1] = 1
      } else {
        times[\$1] += \$2
        if (\$3 > la[\$1]) la[\$1] = \$3
      }
    }
    END {
      for (i in paths) printf \"%-10s %s\n\", $prior, i
    }" 2>> "${_FASD_SINK:-/dev/null}"
}

# query the db, --query [$typ ["$fnd" [$mode]]]
_fasd_query() {
  local typ="${1:-e}"
  local fnd="$2"
  local mode="$3"

  # fetch data from backends
  local _fasd_data
  _fasd_data="$(_fasd_query_load)"

  local -a raw_lines
  raw_lines=(${(f)_fasd_data})
  (( ${#raw_lines} == 0 )) && return

  # build the patterns of the matching passes, tried in order
  local -a pats
  _fasd_query_patterns "$fnd"

  local -a matched_lines
  local pat l p
  for pat in $pats; do
    for l in $raw_lines; do
      p="${l%%\|*}"
      [[ "$p" == $~pat ]] || continue
      case $typ in
        d) [[ -d "$p" ]] ;;
        f) [[ -f "$p" ]] ;;
        *) [[ -e "$p" ]] ;;
      esac && matched_lines+="$l"
    done
    (( ${#matched_lines} )) && break
  done

  (( ${#matched_lines} == 0 )) && return

  print -rl -- "${matched_lines[@]}" | _fasd_query_score "$mode"
}

_fasd_init_env() {
  { # rc files and defaults intentionally set global parameters
    setopt nowarncreateglobal

    # source rc files if present (skipped when $_FASD_NORC is set)
    if [[ -z "$_FASD_NORC" ]]; then
      [ -s "/etc/fasdrc" ] && . "/etc/fasdrc"
      [ -s "$HOME/.fasdrc" ] && . "$HOME/.fasdrc"
    fi

    # set default options
    : "${_FASD_DATA:=$HOME/.fasd}"
    : "${_FASD_BLACKLIST:=--help}"
    : "${_FASD_SHIFT:=sudo busybox}"
    : "${_FASD_IGNORE:=fasd ls echo}"
    : "${_FASD_SINK:=/dev/null}"
    : "${_FASD_TRACK_PWD:=1}"
    : "${_FASD_MAX:=2000}"
    : "${_FASD_BACKENDS:=native}"
    : "${_FASD_FUZZY:=2}"
    : "${_FASD_VIMINFO:=$HOME/.viminfo}"
    : "${_FASD_RECENTLY_USED_XBEL:=$HOME/.local/share/recently-used.xbel}"

    zmodload zsh/datetime zsh/system zsh/zselect

    if [ -z "$_FASD_AWK" ]; then
      local awk
      for awk in mawk gawk original-awk nawk awk; do
        $awk "" 2>/dev/null && _FASD_AWK=$awk && break
      done
    fi
  } >> "${_FASD_SINK:-/dev/null}" 2>&1
}

# prints the shell code for one --init module (all but "env")
_fasd_init_code() {
  case $1 in
    auto)
      cat <<'EOS'
{
  eval "$(fasd --init posix-alias zsh-hook zsh-ccomp zsh-ccomp-install \
    zsh-wcomp zsh-wcomp-install)"
} >> "${_FASD_SINK:-/dev/null}" 2>&1
EOS
      ;;

    posix-alias)
      cat <<'EOS'
alias a='fasd -a'
alias s='fasd -si'
alias sd='fasd -sid'
alias sf='fasd -sif'
alias d='fasd -d'
alias f='fasd -f'
# function to execute built-in cd
fasd_cd() {
  if [ $# -le 1 ]; then
    fasd "$@"
  else
    local _fasd_ret="$(fasd -e 'printf %s' "$@")"
    [ -z "$_fasd_ret" ] && return
    [ -d "$_fasd_ret" ] && cd "$_fasd_ret" || printf '%s\n' "$_fasd_ret"
  fi
}
alias z='fasd_cd -d'
alias zz='fasd_cd -d -i'
EOS
      ;;

    zsh-hook)
      cat <<'EOS'
# add zsh hook
_fasd_preexec() {
  { fasd --proc ${(z)2}; } >> "${_FASD_SINK:-/dev/null}" 2>&1
}
autoload -Uz add-zsh-hook
add-zsh-hook preexec _fasd_preexec
EOS
      ;;

    zsh-ccomp)
      cat <<'EOS'
# zsh command mode completion
_fasd_zsh_cmd_complete() {
  local compl
  read -c compl
  (( $+compstate )) && compstate[insert]=menu
  reply=(${(f)"$(fasd --complete "$compl")"})
}
EOS
      ;;

    zsh-wcomp)
      cat <<'EOS'
(( $+functions[compdef] )) && {
  # zsh word mode completion
  _fasd_zsh_word_complete() {
    local _fasd_cur="${2:-${words[CURRENT]}}"
    local fnd="${_fasd_cur//,/ }"
    local typ="${1:-e}" opt=-a
    [[ $typ == [fd] ]] && opt=-$typ
    local -a results
    # best match first: compadd -V keeps this order
    results=(${(f)"$(fasd -lR $opt "$fnd" 2>> "${_FASD_SINK:-/dev/null}")"})
    (( ${#results} )) && compadd -U -V fasd -- "${results[@]}"
    compstate[insert]=menu
  }
  _fasd_zsh_word_complete_f() { _fasd_zsh_word_complete f "$@" ; }
  _fasd_zsh_word_complete_d() { _fasd_zsh_word_complete d "$@" ; }
  _fasd_zsh_word_complete_trigger() {
    local _fasd_cur="${words[CURRENT]}"
    eval "$(fasd --word-complete-trigger _fasd_zsh_word_complete "$_fasd_cur")"
  }
  # define zle widgets
  zle -C fasd-complete complete-word _generic
  zstyle ':completion:fasd-complete:*' completer _fasd_zsh_word_complete
  zstyle ':completion:fasd-complete:*' menu-select

  zle -C fasd-complete-f complete-word _generic
  zstyle ':completion:fasd-complete-f:*' completer _fasd_zsh_word_complete_f
  zstyle ':completion:fasd-complete-f:*' menu-select

  zle -C fasd-complete-d complete-word _generic
  zstyle ':completion:fasd-complete-d:*' completer _fasd_zsh_word_complete_d
  zstyle ':completion:fasd-complete-d:*' menu-select
}
EOS
      ;;

    zsh-ccomp-install)
      cat <<'EOS'
# enable command mode completion
compctl -U -K _fasd_zsh_cmd_complete -V fasd -x 'C[-1,-*e],s[-]n[1,e]' -c - \
  'c[-1,-A][-1,-D]' -f -- fasd fasd_cd
EOS
      ;;

    zsh-wcomp-install)
      cat <<'EOS'
(( $+functions[compdef] )) && {
  # enable word mode completion
  local orig_comp
  orig_comp="$(zstyle -L ':completion:\*' completer 2>> "${_FASD_SINK:-/dev/null}")"
  if [ -n "$orig_comp" ]; then
    case $orig_comp in
      *_fasd_zsh_word_complete_trigger*);;
      *) eval "$orig_comp _fasd_zsh_word_complete_trigger";;
    esac
  else
    zstyle ':completion:*' completer _complete _fasd_zsh_word_complete_trigger
  fi
}
EOS
      ;;
  esac
}

# loops over --init modules
_fasd_init() {
  while [[ -n "$1" ]]; do
    case $1 in
      env) _fasd_init_env ;;
      *) _fasd_init_code "$1" ;;
    esac
    shift
  done
}

fasd() {
  setopt localoptions extendedglob warncreateglobal

  case $1 in
  --init) shift
    _fasd_init "$@"
    ;;

  # if "$_fasd_cur" or "$2" is a query, then output shell code to be eval'd
  --word-complete-trigger)
    shift
    _fasd_word_complete_trigger "$@"
    ;;

  --proc) shift # process commands
    _fasd_proc "$@"
    ;;

  --lock) # lock $_FASD_DATA for writing, sets the caller's local $lockfd
    _fasd_lock
    ;;

  --add|-A) shift # add entries
    _fasd_add "$@"
    ;;

  --delete|-D) shift # delete entries
    _fasd_delete "$@"
    ;;

  --query) shift # query the db, --query [$typ ["$fnd" [$mode]]]
    _fasd_query "$@"
    ;;

  --backend)
    shift
    _fasd_backend "$@"
    ;;

  *) # parsing logic and processing
    _fasd_main "$@"
    ;;
  esac
}

# parses fasd's option syntax, filling the CALLER's locals (dynamic scope):
# fnd, last, _FASD_BACKENDS, comp, exec, show, lst, interactive, mode, typ, r,
# _fasd_i, i. When it already fully handled the request (--query/--add/
# --delete, --version, -h), it sets the caller's $_fasd_rc and returns 2;
# the caller must then return $_fasd_rc without calling _fasd_select.
_fasd_usage() {
  echo "fasd [options] [query ...]
[f|a|s|d|z] [options] [query ...]
  options:
    -s         list paths with scores
    -l         list paths without scores
    -i         interactive mode
    -e <cmd>   set command to execute on the result file
    -b <name>  only use <name> backend
    -B <name>  add additional backend <name>
    -a         match files and directories
    -d         match directories only
    -f         match files only
    -r         match by rank only
    -t         match by recent access only
    -R         reverse listing order
    -h         show a brief help message
    -[0-9]     select the nth entry

fasd [-A|-D] [paths ...]
    -A    add paths
    -D    delete paths"
}

# parses one "-xyz" token ($1, with optional argument in $2), filling the
# CALLER's locals (dynamic scope): show, lst, interactive, mode, typ, r,
# exec, _FASD_BACKENDS, _fasd_i, comp (read-only here). If it consumes $2 as
# an option-argument, it sets the caller's $_fasd_shift2. On help (unless
# completing), it sets the caller's $_fasd_rc=0 and returns 2.
_fasd_parse_opt() {
  local o="${1#-}"
  while [[ -n "$o" ]]; do
    case $o in
      s*) show=1 ;;
      l*) lst=1 ;;
      i*) [ -z "$comp" ] && interactive=1 && show=1 ;;
      r*) mode=rank ;;
      t*) mode=recent ;;
      e*)
        o="${o#?}"
        if [ -n "$o" ]; then
          exec="$o"
        else
          exec="${2:?"-e: Argument needed "}"
          _fasd_shift2=1
        fi
        break
        ;;
      b*)
        o="${o#?}"
        if [ -n "$o" ]; then
          _FASD_BACKENDS="$o"
        else
          _FASD_BACKENDS="${2:?"-b: Argument needed"}"
          _fasd_shift2=1
        fi
        break
        ;;
      B*)
        o="${o#?}"
        if [ -n "$o" ]; then
          _FASD_BACKENDS="$_FASD_BACKENDS $o"
        else
          _FASD_BACKENDS="$_FASD_BACKENDS ${2:?"-B: Argument needed"}"
          _fasd_shift2=1
        fi
        break
        ;;
      a*) typ=e ;;
      d*) typ=d ;;
      f*) typ=f ;;
      R*) r=r ;;
      [0-9]*) _fasd_i="$o"; break ;;
      h*)
        [ -z "$comp" ] && _fasd_usage >&2 && { _fasd_rc=0; return 2; }
        ;;
    esac
    o="${o#?}"
  done
  return 0
}

_fasd_parse_args() {
  while [[ -n "$1" ]]; do
    case $1 in
      --complete) [ "$2" = "--" ] && shift; set -- ${=2}; lst=1; r=r; comp=1 ;;
      --query) shift; _fasd_query "$@"; _fasd_rc=$?; return 2 ;;
      --add|-A) shift; _fasd_add "$@"; _fasd_rc=$?; return 2 ;;
      --delete|-D) shift; _fasd_delete "$@"; _fasd_rc=$?; return 2 ;;
      --version) [ -z "$comp" ] && echo "$_FASD_VERSION" && { _fasd_rc=0; return 2; } ;;
      --) while [[ -n "$2" ]]; do shift; fnd="$fnd $1"; last="$1"; done ;;
      -*)
        _fasd_parse_opt "$1" "$2"
        (( $? == 2 )) && return 2
        if [[ -n "$_fasd_shift2" ]]; then
          shift
          _fasd_shift2=
        fi
        ;;
      *) fnd="$fnd $1"; last="$1" ;;
    esac
    shift
  done
  return 0
}

# selects and prints/execs a result, using the CALLER's locals (dynamic
# scope, filled by _fasd_parse_args): fnd, last, _FASD_BACKENDS, exec, show,
# lst, interactive, mode, typ, r, _fasd_i, i.
_fasd_select() {
  # guess whether the last query is selected from tab completion
  case $last in
    /?*)
      if [ -z "$show$lst" ] && [ -n "$exec" ]; then
        case "$typ" in
          d) [[ -d "$last" ]] && { eval "${exec} \"\$last\""; return; } ;;
          f) [[ -f "$last" ]] && { eval "${exec} \"\$last\""; return; } ;;
          *) [[ -e "$last" ]] && { eval "${exec} \"\$last\""; return; } ;;
        esac
      fi
      ;;
  esac

  local R
  [ -z "$r" ] && R=r || R=
  fnd="${fnd# }"

  local res
  res="$(_fasd_query "$typ" "$fnd" "$mode" 2>> "${_FASD_SINK:-/dev/null}")"
  [ $? -gt 0 ] && return

  if [ 0 -lt ${_fasd_i:-0} ] 2>> "${_FASD_SINK:-/dev/null}"; then
    res="$(printf '%s\n' "$res" | sort -n${R} | sed -n "$_fasd_i"'s/^[^ ]*[ ]*//p')"
  elif [ -n "$interactive" ] || [ -n "$exec" -a -z "$fnd$lst$show" -a -t 1 ]; then
    local line_count="$(printf '%s\n' "$res" | sed -n '$=')"
    if [ "${line_count:-0}" -gt 1 ]; then
      res="$(printf '%s\n' "$res" | sort -n${R})"
      printf '%s\n' "$res" | sed = | sed 'N;s/\n/	/' | sort -nr >&2
      printf "> " >&2
      read i
      [ 0 -lt "${i:-0}" ] 2>> "${_FASD_SINK:-/dev/null}" || return 1
    fi
    res="$(printf '%s\n' "$res" | sed -n "${i:-1}"'s/^[^ ]*[ ]*//p')"
  elif [ -n "$lst" ]; then
    [ -n "$res" ] && printf '%s\n' "$res" | sort -n${r} | sed 's/^[^ ]*[ ]*//'
    return
  elif [ -n "$show" ]; then
    [ -n "$res" ] && printf '%s\n' "$res" | sort -n${r}
    return
  elif [ -n "$fnd" ] && [ -n "$exec" -o ! -t 1 ]; then # exec or subshell
    res="$(printf '%s\n' "$res" | sort -n | sed -n '$s/^[^ ]*[ ]*//p')"
  else # no args, show
    [ -n "$res" ] && printf '%s\n' "$res" | sort -n${r}
    return
  fi

  if [ -n "$res" ]; then
    _fasd_add "$res"
    if [ -z "$exec" ]; then
      print -r -- "$res"
    else
      eval "${exec} \"\$res\""
    fi
  fi
}

# the "*" branch: option parsing, then selection and output
_fasd_main() {
  local fnd= last= _FASD_BACKENDS="$_FASD_BACKENDS" _fasd_data= comp= exec=
  local show= lst= interactive= mode= typ= r= _fasd_i= i= _fasd_rc= _fasd_shift2=

  _fasd_parse_args "$@"
  (( $? == 2 )) && return $_fasd_rc

  _fasd_select
}

fasd --init env

if [[ "$ZSH_EVAL_CONTEXT" == *:file* ]]; then
  # Sourced in zsh: function is defined, environment initialized.
  return 0 2>/dev/null || true
else
  # Executed as script: run command
  fasd "$@"
fi
